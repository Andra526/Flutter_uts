# Salin menjadi .env di folder yang sama dengan docker-compose.yml, lalu isi.
# JANGAN commit .env ke Git.

# Password PostgreSQL. Pakai huruf+angka saja (karakter khusus merusak URL koneksi).
# Buat: openssl rand -hex 24
POSTGRES_PASSWORD=

# Secret token login. Minimal 32 karakter acak. Buat: openssl rand -base64 48
JWT_SECRET=

# Domain (tanpa https://). Keduanya harus diarahkan (DNS A record) ke IP VPS.
WEB_DOMAIN=gymfitku.com
API_DOMAIN=api.gymfitku.com

# Email untuk sertifikat HTTPS Let's Encrypt
ACME_EMAIL=
