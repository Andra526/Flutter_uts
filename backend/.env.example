# Salin file ini menjadi .env, lalu isi nilai yang bertanda <...>.
# JANGAN commit .env ke Git dan jangan menaruh password asli di file ini.

# --- Server ---
PORT=3000
NODE_ENV=development
# Wajib diganti di production (minimal 32 karakter acak). Contoh membuat: openssl rand -base64 48
JWT_SECRET="ganti-dengan-secret-yang-panjang-dan-acak"
JWT_EXPIRES_IN="7d"
# Domain yang boleh memanggil API dari browser (website admin), pisahkan dengan koma.
# Kosong = semua origin diizinkan (hanya untuk pengembangan).
# Contoh: CORS_ORIGINS="https://admin.contoh.com,https://app.contoh.com"
CORS_ORIGINS=""
# Isi 1 bila backend berada di belakang reverse proxy / platform hosting (Nginx, Render, Railway, dll)
# agar IP klien terbaca benar.
TRUST_PROXY=0

# --- Database: PostgreSQL (Supabase) ---
# Runtime aplikasi. Disarankan connection pooler Supabase (Supavisor).
#   Session pooler     : postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
#   Transaction pooler : postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
# Password yang mengandung karakter khusus (@ : / ? # %) harus di-URL-encode.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres"
# Untuk Prisma Migrate (CLI). Koneksi langsung Supabase, atau session pooler bila jaringan IPv4-only.
#   postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres"
# auto (default) | require | no-verify | disable   -- lihat docs/supabase-migration.md
DATABASE_SSL="auto"
# Isi sertifikat CA Supabase (PEM) bila ingin verifikasi SSL penuh. Opsional.
# DATABASE_SSL_CA=""
DATABASE_POOL_MAX=10
# Schema PostgreSQL yang dipakai (default public).
# DATABASE_SCHEMA=public

# --- Upload foto ---
# local    : simpan di folder UPLOAD_DIR (hanya cocok bila disk server permanen / VPS).
# supabase : simpan di Supabase Storage (disarankan untuk hosting yang disknya sementara).
UPLOAD_DRIVER=local
# UPLOAD_DIR=./uploads
# Wajib bila UPLOAD_DRIVER=supabase:
# SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<SERVICE_ROLE_KEY>"   # RAHASIA: hanya di server, jangan ke Flutter/website
# SUPABASE_STORAGE_BUCKET="gymfit-uploads"          # bucket dibuat Public

# --- Khusus tes e2e (database TERPISAH, jangan arahkan ke database production) ---
# TEST_DATABASE_URL="postgresql://postgres:<PASSWORD>@localhost:5432/gymfit_test"
